{{!-- Player-facing reader. Storage only: Learn hands off to the Send to Slot dialog. --}}
<div class="sws-loot-book-inner">

  <header class="sws-loot-book-header">
    {{#if img}}<img class="sws-loot-book-art" src="{{img}}" alt="" />{{/if}}
    <div class="sws-loot-book-meta">
      <span class="sws-loot-book-line">{{metaLine}}</span>
      <span class="sws-loot-book-target{{#unless hasTarget}} is-warning{{/unless}}">{{targetLine}}</span>
      {{#if seedLine}}<span class="sws-loot-book-seed">{{seedLine}}</span>{{/if}}
    </div>
  </header>

  <div class="sws-loot-spells">
    {{#if hasSpells}}
      {{#each groups}}
        <div class="sws-group-header">
          <span class="sws-group-title">{{label}}</span>
        </div>
        {{#each spells}}
          <div class="sws-spell-row{{#if alreadyLearned}} is-learned{{/if}}">
            <span class="sws-rank-badge">{{rankBadge}}</span>
            <span class="sws-spell-name" title="{{name}}">{{name}}</span>
            {{!-- Always rendered, empty tag included, so the grid columns line up
                  whether or not anyone has learned the spell yet. --}}
            <span class="sws-spell-tags">
              {{#if rarityLabel}}<span class="sws-pill sws-pill-rarity-{{rarity}}">{{rarityLabel}}</span>{{/if}}
            </span>
            <span class="sws-learned-tag" title="{{learnedBy}}">
              {{#if learnedBy}}<i class="fa-solid fa-check"></i> {{learnedBy}}{{/if}}
            </span>
            <button type="button" class="sws-icon-button sws-learn" data-action="learn" data-uuid="{{uuid}}"
                    data-tooltip="{{localize 'SWS.Loot.Learn'}}"
                    aria-label="{{localize 'SWS.Loot.Learn'}}"
                    {{#if disabled}}disabled{{/if}}>
              <i class="fa-solid fa-graduation-cap"></i>
            </button>
          </div>
        {{/each}}
      {{/each}}
    {{else}}
      <div class="sws-empty">
        <i class="fa-solid fa-book-skull"></i>
        <p class="sws-empty-title">{{localize "SWS.Loot.EmptyBook"}}</p>
      </div>
    {{/if}}
  </div>

  <footer class="sws-loot-book-footer">
    <p class="sws-ownership-note">
      <i class="fa-solid fa-wand-magic-sparkles"></i>
      {{localize "SWS.Loot.ReaderNote"}}
    </p>
  </footer>

</div>

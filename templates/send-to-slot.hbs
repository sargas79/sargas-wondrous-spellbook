{{!-- The one write path from a spellbook to an actor: pick an entry, then a rank. --}}
<div class="sws-slot-inner">

  <div class="sws-slot-spell">
    <img src="{{spell.img}}" alt="" />
    <div class="sws-slot-spell-text">
      <span class="sws-slot-spell-name">{{spell.name}}</span>
      <span class="sws-slot-spell-sub">{{targetLine}}</span>
    </div>
  </div>

  <div class="sws-slot-fields">
    <div class="sws-field">
      <label for="{{uid}}-entry">{{localize "SWS.Slot.EntryLabel"}}</label>
      <select id="{{uid}}-entry" name="entry">
        {{#each entries}}
          <option value="{{id}}">{{name}}{{#if kind}} ({{kind}}){{/if}}</option>
        {{/each}}
      </select>
    </div>

    <div class="sws-field">
      <label for="{{uid}}-rank">{{localize "SWS.Slot.RankLabel"}}</label>
      <select id="{{uid}}-rank" name="rank" {{#if rankLocked}}disabled{{/if}}>
        {{#each ranks}}
          <option value="{{rank}}" {{#if disabled}}disabled{{/if}}>{{label}}{{#if freeLabel}} ({{freeLabel}}){{/if}}</option>
        {{/each}}
      </select>
    </div>
  </div>

</div>

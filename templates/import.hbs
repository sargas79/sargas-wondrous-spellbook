{{!-- Read-only view of a character's spells, rituals or crafting formulas. Ticked rows
      are written into a book; nothing here ever writes back to the actor. --}}
<div class="sws-import-inner">

  <div class="sws-import-kinds">
    <span class="sws-field-label">{{localize "SWS.Import.KindLabel"}}</span>
    <div class="sws-segments">
      {{#each kinds}}
        <button type="button" class="sws-segment{{#if active}} is-active{{/if}}"
                data-action="setKind" data-kind="{{key}}" aria-pressed="{{active}}">
          {{label}}
        </button>
      {{/each}}
    </div>
  </div>

  <div class="sws-import-form">
    <div class="sws-field">
      <label for="{{partId}}-sws-import-actor">{{localize "SWS.Import.ActorLabel"}}</label>
      <select id="{{partId}}-sws-import-actor" name="actor" {{#unless hasActor}}disabled{{/unless}}>
        {{#each actors}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
        {{/each}}
      </select>
    </div>

    <div class="sws-field">
      <label for="{{partId}}-sws-import-target">{{localize "SWS.Import.TargetLabel"}}</label>
      <select id="{{partId}}-sws-import-target" name="target">
        {{#each targets}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
        {{/each}}
      </select>
    </div>

    <div class="sws-field">
      <label for="{{partId}}-sws-import-name">{{localize "SWS.Import.NameLabel"}}</label>
      <input id="{{partId}}-sws-import-name" type="text" name="bookName" value="{{bookName}}"
             placeholder="{{localize 'SWS.Creator.NamePlaceholder'}}"
             {{#if nameDisabled}}disabled{{/if}} />
    </div>
  </div>

  <div class="sws-import-status">
    <span class="sws-import-summary">{{summaryLine}}</span>
    <span class="sws-import-bulk">
      <button type="button" class="sws-button sws-button-small" data-action="selectAll">
        {{localize "SWS.Loot.SourcesAllButton"}}
      </button>
      <button type="button" class="sws-button sws-button-small" data-action="selectNone">
        {{localize "SWS.Loot.SourcesNoneButton"}}
      </button>
    </span>
  </div>

  {{#if noteLine}}
    <p class="sws-import-note">
      <i class="fa-solid fa-circle-info"></i> {{noteLine}}
    </p>
  {{/if}}

  <div class="sws-import-list">
    {{#if hasRows}}
      {{#each groups}}
        <div class="sws-group-header sws-import-group">
          <label class="sws-checkbox sws-import-group-check">
            <input type="checkbox" data-group="{{id}}" />
            <span class="sws-group-title">{{name}}</span>
          </label>
          {{#if kind}}<span class="sws-pill">{{kind}}</span>{{/if}}
          <span class="sws-group-count" data-group-count="{{id}}">
            {{localize "SWS.Import.GroupCount" selected=selectedCount total=rows.length}}
          </span>
        </div>

        {{#each rows}}
          <label class="sws-spell-row sws-import-row">
            <span class="sws-row-check">
              <input type="checkbox" data-item-id="{{itemId}}" data-group-id="{{../id}}"
                     {{#if selected}}checked{{/if}} />
            </span>
            <span class="sws-rank-badge">{{rankBadge}}</span>
            <span class="sws-spell-name" title="{{name}}{{#if sourceName}} ({{sourceName}}){{/if}}">
              {{name}}
              {{#if sourceName}}<span class="sws-import-source-name">{{sourceName}}</span>{{/if}}
            </span>

            {{#if isFormula}}
              <span class="sws-import-detail" title="{{price}}">{{price}}</span>
              <span class="sws-traditions">
                {{#if itemTypeLabel}}<span class="sws-pill">{{itemTypeLabel}}</span>{{/if}}
                <span class="sws-pill sws-pill-rarity-{{rarity}}">{{rarityLabel}}</span>
              </span>
            {{else}}
              <span class="sws-import-detail" title="{{detailLine}}">{{detailLine}}</span>
              <span class="sws-traditions">
                {{#each traditionTags}}<span class="sws-pill sws-pill-{{key}}">{{label}}</span>{{/each}}
                {{#if isFocus}}<span class="sws-pill sws-pill-focus">{{localize "SWS.Rank.Focus"}}</span>{{/if}}
                {{#unless linked}}
                  <span class="sws-pill sws-pill-unlinked"
                        data-tooltip="{{localize 'SWS.Import.UnlinkedTooltip'}}">
                    {{localize "SWS.Import.Unlinked"}}
                  </span>
                {{/unless}}
              </span>
            {{/if}}
          </label>
        {{/each}}
      {{/each}}
    {{else}}
      <div class="sws-empty">
        <i class="fa-solid fa-hat-wizard"></i>
        {{#if hasActor}}
          <p class="sws-empty-title">{{emptyTitle}}</p>
          <p class="sws-empty-hint">{{emptyHint}}</p>
        {{else}}
          <p class="sws-empty-title">{{noActorsLine}}</p>
        {{/if}}
      </div>
    {{/if}}
  </div>

  <footer class="sws-import-footer">
    <p class="sws-ownership-note">
      <i class="fa-solid fa-shield-halved"></i>
      {{localize "SWS.Import.ReadOnlyNote"}}
    </p>

    <div class="sws-import-actions">
      <button type="button" class="sws-button sws-button-primary" data-action="import"
              {{#unless canImport}}disabled{{/unless}}>
        <i class="fa-solid fa-file-import"></i> {{importLabel}}
      </button>
      <button type="button" class="sws-button" data-action="cancel">{{localize "SWS.Creator.Cancel"}}</button>
    </div>
  </footer>

</div>

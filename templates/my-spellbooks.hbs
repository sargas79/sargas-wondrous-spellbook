{{!-- Ownership-filtered list of spellbooks. GMs see every book; players see their own. --}}
<div class="bws-browser-inner">

  <header class="bws-browser-header">
    <span class="bws-browser-scope">
      {{folderLine}} <span class="bws-dot">&middot;</span> {{scopeLine}}
    </span>
    <span class="bws-browser-actions">
      {{#if isGM}}
        <button type="button" class="bws-button bws-button-small" data-action="rollLoot"
                data-tooltip="{{localize 'BWS.Loot.RollTooltip'}}">
          <i class="fa-solid fa-dice-d20"></i> {{localize "BWS.Loot.RollButton"}}
        </button>
      {{/if}}
      <button type="button" class="bws-button bws-button-small" data-action="importSheet"
              data-tooltip="{{localize 'BWS.Import.ButtonTooltip'}}">
        <i class="fa-solid fa-file-import"></i> {{localize "BWS.Import.Button"}}
      </button>
      <button type="button" class="bws-button bws-button-primary bws-button-small" data-action="create">
        <i class="fa-solid fa-plus"></i> {{localize "BWS.Browser.New"}}
      </button>
    </span>
  </header>

  <div class="bws-book-list">
    {{#if hasBooks}}
      {{#each books}}
        <div class="bws-book-row">
          <div class="bws-book-main">
            <span class="bws-book-name" title="{{name}}">{{name}}</span>
            <span class="bws-book-meta">
              {{countLabel}}
              {{#unless canEdit}}
                <span class="bws-readonly-tag">
                  <i class="fa-solid fa-lock"></i> {{localize "BWS.Browser.ReadOnly"}}
                </span>
              {{/unless}}
            </span>
            {{#if ranks.length}}
              <span class="bws-book-ranks">
                {{#each ranks}}<span class="bws-rank-badge">{{badge}}</span>{{/each}}
              </span>
            {{/if}}
          </div>

          <div class="bws-book-controls">
            <button type="button" class="bws-icon-button" data-action="open" data-id="{{id}}"
                    data-tooltip="{{localize 'BWS.Browser.Open'}}"
                    aria-label="{{localize 'BWS.Browser.Open'}}">
              <i class="fa-solid fa-book-open"></i>
            </button>
            <button type="button" class="bws-icon-button" data-action="edit" data-id="{{id}}"
                    data-tooltip="{{localize 'BWS.Browser.Edit'}}"
                    aria-label="{{localize 'BWS.Browser.Edit'}}"
                    {{#unless canEdit}}disabled{{/unless}}>
              <i class="fa-solid fa-pen-to-square"></i>
            </button>
            <button type="button" class="bws-icon-button bws-icon-danger" data-action="remove" data-id="{{id}}"
                    data-tooltip="{{localize 'BWS.Browser.Delete'}}"
                    aria-label="{{localize 'BWS.Browser.Delete'}}"
                    {{#unless canEdit}}disabled{{/unless}}>
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
        </div>
      {{/each}}
    {{else}}
      <div class="bws-empty">
        <i class="fa-solid fa-book-sparkles"></i>
        <p class="bws-empty-title">{{localize "BWS.Browser.Empty"}}</p>
        <p class="bws-empty-hint">{{localize "BWS.Browser.EmptyHint"}}</p>
        <button type="button" class="bws-button bws-button-primary" data-action="create">
          <i class="fa-solid fa-plus"></i> {{localize "BWS.Browser.EmptyAction"}}
        </button>
      </div>
    {{/if}}
  </div>

</div>

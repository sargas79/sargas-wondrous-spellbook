{{!-- Ownership-filtered list of spellbooks, ritual books, formula books and rolled loot
      books. GMs see every book; players see their own. Each row carries its `kind` so the
      handlers know which document collection to look in, and a journal row also carries
      `bookKind` for what it holds. --}}
<div class="sws-browser-inner">

  <header class="sws-browser-header">
    <span class="sws-browser-scope">
      {{folderLine}} <span class="sws-dot">&middot;</span> {{scopeLine}}
    </span>
    <span class="sws-browser-actions">
      {{#if isGM}}
        <button type="button" class="sws-button sws-button-small" data-action="rollLoot"
                data-tooltip="{{localize 'SWS.Loot.RollTooltip'}}">
          <i class="fa-solid fa-dice-d20"></i> {{localize "SWS.Loot.RollButton"}}
        </button>
      {{/if}}
      <button type="button" class="sws-button sws-button-small" data-action="importSheet"
              data-tooltip="{{localize 'SWS.Import.ButtonTooltip'}}">
        <i class="fa-solid fa-file-import"></i> {{localize "SWS.Import.Button"}}
      </button>
      <button type="button" class="sws-button sws-button-primary sws-button-small" data-action="create">
        <i class="fa-solid fa-plus"></i> {{localize "SWS.Browser.New"}}
      </button>
    </span>
  </header>

  <div class="sws-book-list">
    {{#if hasBooks}}
      {{#each books}}
        <div class="sws-book-row">
          <div class="sws-book-main">
            <span class="sws-book-name" title="{{name}}">
              {{!-- Journal rows only: a loot book is tagged by the dice pill below. --}}
              {{#if kindIcon}}
                <i class="{{kindIcon}} sws-book-kind-icon" data-tooltip="{{kindLabel}}"></i>
              {{/if}}
              {{name}}
            </span>
            <span class="sws-book-meta">
              {{countLabel}}
              {{#if lootLabel}}
                <span class="sws-loot-tag">
                  <i class="fa-solid fa-dice-d20"></i> {{lootLabel}}
                </span>
              {{/if}}
              {{#unless canEdit}}
                <span class="sws-readonly-tag">
                  <i class="fa-solid fa-lock"></i> {{localize "SWS.Browser.ReadOnly"}}
                </span>
              {{/unless}}
            </span>
            {{#if ranks.length}}
              <span class="sws-book-ranks">
                {{#each ranks}}<span class="sws-rank-badge">{{badge}}</span>{{/each}}
              </span>
            {{/if}}
          </div>

          <div class="sws-book-controls">
            <button type="button" class="sws-icon-button" data-action="open" data-id="{{id}}" data-kind="{{kind}}"
                    data-tooltip="{{openHint}}" aria-label="{{openHint}}">
              <i class="fa-solid fa-book-open"></i>
            </button>
            {{!-- A formula book is read, not edited: its control opens the crafter's
                  reader, and stays enabled for a book you only have read access to,
                  because teaching writes to the crafter rather than to the book. --}}
            {{#if isFormulas}}
              <button type="button" class="sws-icon-button" data-action="edit" data-id="{{id}}" data-kind="{{kind}}"
                      data-tooltip="{{localize 'SWS.Formula.OpenBook'}}"
                      aria-label="{{localize 'SWS.Formula.OpenBook'}}">
                <i class="fa-solid fa-hammer"></i>
              </button>
            {{else}}
              <button type="button" class="sws-icon-button" data-action="edit" data-id="{{id}}" data-kind="{{kind}}"
                      data-tooltip="{{editHint}}" aria-label="{{editHint}}"
                      {{#unless canEdit}}disabled{{/unless}}>
                <i class="fa-solid fa-pen-to-square"></i>
              </button>
            {{/if}}
            <button type="button" class="sws-icon-button sws-icon-danger" data-action="remove" data-id="{{id}}" data-kind="{{kind}}"
                    data-tooltip="{{deleteHint}}" aria-label="{{deleteHint}}"
                    {{#unless canEdit}}disabled{{/unless}}>
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
        </div>
      {{/each}}
    {{else}}
      <div class="sws-empty">
        <i class="fa-solid fa-book-sparkles"></i>
        <p class="sws-empty-title">{{localize "SWS.Browser.Empty"}}</p>
        <p class="sws-empty-hint">{{localize "SWS.Browser.EmptyHint"}}</p>
        <button type="button" class="sws-button sws-button-primary" data-action="create">
          <i class="fa-solid fa-plus"></i> {{localize "SWS.Browser.EmptyAction"}}
        </button>
      </div>
    {{/if}}
  </div>

</div>

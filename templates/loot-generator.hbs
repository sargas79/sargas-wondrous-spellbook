{{!-- GM-facing loot roller: parameters on top, rolled preview below. --}}
<div class="sws-loot-inner">

  <section class="sws-loot-form">
    <div class="sws-field sws-loot-field-level">
      <label for="{{partId}}-sws-loot-level">{{localize "SWS.Loot.LevelLabel"}}</label>
      <input id="{{partId}}-sws-loot-level" type="number" name="level" min="1" max="{{maxLevel}}" step="1"
             value="{{level}}" />
      <span class="sws-field-hint">{{localize "SWS.Loot.MaxRankHint" rank=maxRank}}</span>
    </div>

    <div class="sws-field">
      <label for="{{partId}}-sws-loot-tradition">{{localize "SWS.Loot.TraditionLabel"}}</label>
      <select id="{{partId}}-sws-loot-tradition" name="tradition">
        {{#each traditions}}
          <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>

    <div class="sws-field">
      <label for="{{partId}}-sws-loot-profile">{{localize "SWS.Loot.ProfileLabel"}}</label>
      <select id="{{partId}}-sws-loot-profile" name="profile">
        {{#each profiles}}
          <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>

    <div class="sws-field">
      <label for="{{partId}}-sws-loot-rarity">{{localize "SWS.Loot.RarityLabel"}}</label>
      <select id="{{partId}}-sws-loot-rarity" name="maxRarity">
        {{#each rarities}}
          <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>

    <div class="sws-field">
      <label for="{{partId}}-sws-loot-count">{{localize "SWS.Loot.CountLabel"}}</label>
      <input id="{{partId}}-sws-loot-count" type="number" name="count" min="1" max="60" step="1" value="{{count}}"
             placeholder="{{localize 'SWS.Loot.CountAuto'}}" />
      <span class="sws-field-hint">{{localize "SWS.Loot.CountHint"}}</span>
    </div>

    <div class="sws-field sws-loot-field-seed">
      <label for="{{partId}}-sws-loot-seed">{{localize "SWS.Loot.SeedLabel"}}</label>
      <div class="sws-seed-row">
        <input id="{{partId}}-sws-loot-seed" type="text" name="seed" value="{{seed}}" spellcheck="false" />
        <button type="button" class="sws-icon-button" data-action="newSeed"
                data-tooltip="{{localize 'SWS.Loot.NewSeed'}}"
                aria-label="{{localize 'SWS.Loot.NewSeed'}}">
          <i class="fa-solid fa-dice"></i>
        </button>
      </div>
    </div>

    <div class="sws-loot-toggles">
      <label class="sws-checkbox">
        <input type="checkbox" name="includeCantrips" {{#if includeCantrips}}checked{{/if}} />
        <span>{{localize "SWS.Loot.IncludeCantrips"}}</span>
      </label>
      <label class="sws-checkbox">
        <input type="checkbox" name="includeFocus" {{#if includeFocus}}checked{{/if}} />
        <span>{{localize "SWS.Creator.IncludeFocus"}}</span>
      </label>
      <button type="button" class="sws-button sws-button-small" data-action="pickSources"
              data-tooltip="{{localize 'SWS.Loot.SourcesTooltip'}}">
        <i class="fa-solid fa-book-open"></i> {{sourceLabel}}
      </button>
      <button type="button" class="sws-button sws-button-small" data-action="reroll">
        <i class="fa-solid fa-rotate"></i> {{localize "SWS.Loot.Reroll"}}
      </button>
    </div>
  </section>

  <section class="sws-loot-result">
    <div class="sws-loot-summary">
      <span class="sws-loot-summary-line">{{summaryLine}}</span>
      {{#if edited}}
        <span class="sws-loot-tag"><i class="fa-solid fa-pen"></i> {{localize "SWS.Loot.EditedTag"}}</span>
      {{/if}}
    </div>
    {{#if shortfall}}
      <p class="sws-loot-warning">
        <i class="fa-solid fa-triangle-exclamation"></i>
        {{localize "SWS.Loot.Shortfall" count=shortfall}}
      </p>
    {{/if}}
  </section>

  <div class="sws-loot-preview">
    {{#if hasSpells}}
      {{#each groups}}
        <div class="sws-group-header">
          <span class="sws-group-title">{{label}}</span>
        </div>
        {{#each spells}}
          <div class="sws-spell-row">
            <span class="sws-rank-badge">{{rankBadge}}</span>
            <span class="sws-spell-name" title="{{name}}">{{name}}</span>
            <span class="sws-traditions">
              <span class="sws-pill sws-pill-rarity-{{rarity}}" title="{{sourceLabel}}">{{rarityLabel}}</span>
              {{#each traditionTags}}<span class="sws-pill sws-pill-{{key}}">{{label}}</span>{{/each}}
            </span>
            <button type="button" class="sws-icon-button" data-action="rerollSpell" data-uuid="{{uuid}}"
                    data-tooltip="{{localize 'SWS.Loot.RerollSpell'}}"
                    aria-label="{{localize 'SWS.Loot.RerollSpell'}}">
              <i class="fa-solid fa-dice-d20"></i>
            </button>
            <button type="button" class="sws-icon-button sws-icon-danger" data-action="removeSpell" data-uuid="{{uuid}}"
                    data-tooltip="{{localize 'SWS.Loot.RemoveSpell'}}"
                    aria-label="{{localize 'SWS.Loot.RemoveSpell'}}">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        {{/each}}
      {{/each}}
    {{else}}
      <div class="sws-empty">
        <i class="fa-solid fa-book-skull"></i>
        <p class="sws-empty-title">{{localize "SWS.Loot.EmptyRoll"}}</p>
        <p class="sws-empty-hint">{{localize "SWS.Loot.EmptyRollHint"}}</p>
      </div>
    {{/if}}
  </div>

  <footer class="sws-loot-footer">
    <div class="sws-field sws-loot-field-name">
      <label for="{{partId}}-sws-loot-name">{{localize "SWS.Loot.NameLabel"}}</label>
      <input id="{{partId}}-sws-loot-name" type="text" name="bookName" value="{{bookName}}"
             placeholder="{{localize 'SWS.Loot.NamePlaceholder'}}" autocomplete="off" />
    </div>

    <div class="sws-loot-targets" role="radiogroup" aria-label="{{localize 'SWS.Loot.TargetLabel'}}">
      <label class="sws-checkbox">
        <input type="radio" name="target" value="directory" {{#if targetIsDirectory}}checked{{/if}} />
        <span>{{localize "SWS.Loot.TargetFolder" folder=folderName}}</span>
      </label>
      <label class="sws-checkbox">
        <input type="radio" name="target" value="selected" {{#if targetIsSelected}}checked{{/if}} />
        <span>{{localize "SWS.Loot.TargetSelected" count=selectedCount}}</span>
      </label>
      {{#if targetIsSelected}}
        <span class="sws-field-hint">
          {{#if selectedCount}}{{selectedNames}}{{else}}{{localize "SWS.Loot.NoSelection"}}{{/if}}
        </span>
      {{/if}}
    </div>

    <div class="sws-loot-actions">
      <button type="button" class="sws-button sws-button-primary" data-action="create"
              {{#unless canCreate}}disabled{{/unless}}>
        <i class="fa-solid fa-book-sparkles"></i> {{localize "SWS.Loot.Create"}}
      </button>
      <button type="button" class="sws-button" data-action="cancel">{{localize "SWS.Creator.Cancel"}}</button>
    </div>
  </footer>

</div>

{{!-- A crafter's blueprints. Teaching writes into the chosen crafter's formula list and
      nothing else; the book itself is never consumed. --}}
<div class="bws-formula-book-inner">

  <header class="bws-formula-header">
    <div class="bws-field">
      <label for="{{partId}}-bws-formula-crafter">{{localize "BWS.Formula.CrafterLabel"}}</label>
      <select id="{{partId}}-bws-formula-crafter" name="crafter" {{#unless hasCrafter}}disabled{{/unless}}>
        {{#each crafters}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
        {{/each}}
      </select>
    </div>

    <div class="bws-formula-meta">
      <span class="bws-formula-count">{{countLine}}</span>
      <span class="bws-formula-target{{#unless hasCrafter}} is-warning{{/unless}}">{{targetLine}}</span>
    </div>

    <button type="button" class="bws-button bws-button-small" data-action="teachAll"
            data-tooltip="{{localize 'BWS.Formula.TeachAllTooltip'}}"
            {{#unless canTeachAll}}disabled{{/unless}}>
      <i class="fa-solid fa-clipboard-list"></i>
      {{localize "BWS.Formula.TeachAll" count=unknownCount}}
    </button>
  </header>

  <div class="bws-formula-list">
    {{#if hasFormulas}}
      {{#each groups}}
        <div class="bws-group-header">
          <span class="bws-group-title">{{label}}</span>
        </div>

        {{#each rows}}
          <div class="bws-spell-row bws-formula-row{{#if known}} is-known{{/if}}">
            <span class="bws-spell-name" title="{{name}}">{{name}}</span>
            <span class="bws-formula-price" title="{{price}}">{{price}}</span>
            <span class="bws-spell-tags">
              <span class="bws-pill bws-pill-rarity-{{rarity}}">{{rarityLabel}}</span>
            </span>
            <span class="bws-known-tag">
              {{#if known}}<i class="fa-solid fa-check"></i> {{localize "BWS.Formula.Known"}}{{/if}}
            </span>
            <button type="button" class="bws-icon-button bws-teach" data-action="teach"
                    data-uuid="{{uuid}}" data-name="{{name}}"
                    data-tooltip="{{localize 'BWS.Formula.Teach'}}"
                    aria-label="{{localize 'BWS.Formula.Teach'}}"
                    {{#if disabled}}disabled{{/if}}>
              <i class="fa-solid fa-hammer"></i>
            </button>
          </div>
        {{/each}}
      {{/each}}
    {{else}}
      <div class="bws-empty">
        <i class="fa-solid fa-drafting-compass"></i>
        <p class="bws-empty-title">{{localize "BWS.Formula.EmptyBook"}}</p>
      </div>
    {{/if}}
  </div>

  <footer class="bws-loot-book-footer">
    <p class="bws-ownership-note">
      <i class="fa-solid fa-hammer"></i>
      {{localize "BWS.Formula.ReaderNote"}}
    </p>
  </footer>

</div>

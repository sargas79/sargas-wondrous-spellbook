{{!-- Two columns: the compendium results on the left, the book's contents on the right. --}}
<section class="sws-body">

  <div class="sws-spell-list" role="list">
    {{#if hasResults}}
      {{#each groups}}
        <div class="sws-group-header">
          <span class="sws-group-title">{{label}}</span>
          <span class="sws-group-count">{{countLabel}}</span>
        </div>

        {{#each spells}}
          <div class="sws-spell-row{{#if selected}} is-selected{{/if}}" role="listitem">
            <label class="sws-row-check">
              <input type="checkbox" data-uuid="{{uuid}}" {{#if selected}}checked{{/if}}
                     {{#if ../../readOnly}}disabled{{/if}}
                     aria-label="{{name}}" />
            </label>

            <span class="sws-spell-name" title="{{name}}">{{name}}</span>

            {{#if action.glyph}}
              <span class="sws-action-cost{{#unless action.isNumeric}} is-text{{/unless}}"
                    title="{{action.label}}">{{action.glyph}}</span>
            {{else}}
              <span class="sws-action-cost is-empty"></span>
            {{/if}}

            <span class="sws-traditions">
              {{#each traditionTags}}
                <span class="sws-pill sws-pill-{{key}}">{{label}}</span>
              {{/each}}
              {{#if isFocus}}<span class="sws-pill sws-pill-focus">{{localize "SWS.Rank.Focus"}}</span>{{/if}}
            </span>

            {{!-- PF2e casts rituals outside spell slots, so a ritual row has nowhere to be
                  sent. The empty cell keeps the grid's last column in place. --}}
            {{#if isRitual}}
              <span class="sws-send-placeholder"></span>
            {{else}}
              <button type="button" class="sws-send" data-action="sendToSlot" data-uuid="{{uuid}}"
                      data-tooltip="{{localize 'SWS.Creator.SendToSlot'}}"
                      aria-label="{{localize 'SWS.Creator.SendToSlot'}}">
                <i class="fa-solid fa-arrow-down-to-line"></i>
              </button>
            {{/if}}
          </div>
        {{/each}}
      {{/each}}
    {{else}}
      <div class="sws-empty">
        <i class="fa-solid fa-wand-magic-sparkles"></i>
        <p class="sws-empty-title">{{localize "SWS.Creator.NoResults"}}</p>
        <p class="sws-empty-hint">{{localize "SWS.Creator.NoResultsHint"}}</p>
      </div>
    {{/if}}
  </div>

  <aside class="sws-selected">
    <div class="sws-selected-header">
      <span class="sws-selected-label">{{localize "SWS.Creator.Selected"}}</span>
      <span class="sws-selected-count">{{selectedCountLabel}}</span>
    </div>

    <div class="sws-selected-list">
      {{#if selectedCount}}
        {{#each selected}}
          <div class="sws-selected-row">
            <span class="sws-rank-badge">{{rankBadge}}</span>
            <span class="sws-selected-name" title="{{name}}">{{name}}</span>
            {{#unless ../readOnly}}
              <button type="button" class="sws-remove" data-action="removeSelected" data-uuid="{{uuid}}"
                      data-tooltip="{{localize 'SWS.Creator.RemoveFromSelection'}}"
                      aria-label="{{localize 'SWS.Creator.RemoveFromSelection'}}">
                <i class="fa-solid fa-xmark"></i>
              </button>
            {{/unless}}
          </div>
        {{/each}}
      {{else}}
        <p class="sws-selected-empty">{{emptyNote}}</p>
      {{/if}}
    </div>

    <div class="sws-selected-footer">
      <p class="sws-ownership-note">
        <i class="fa-solid fa-lock"></i>
        {{#if readOnly}}
          {{localize "SWS.Creator.ReadOnlyNote"}}
        {{else if cannotCreate}}
          {{localize "SWS.Error.NoJournalCreate"}}
        {{else}}
          {{localize "SWS.Creator.OwnershipNote"}}
        {{/if}}
      </p>
      <button type="button" class="sws-button sws-button-primary" data-action="save"
              {{#unless canSave}}disabled{{/unless}}>
        <i class="fa-solid fa-floppy-disk"></i> {{saveLabel}}
      </button>
      <button type="button" class="sws-button" data-action="cancel">
        {{localize "SWS.Creator.Cancel"}}
      </button>
    </div>
  </aside>

</section>
